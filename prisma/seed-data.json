  "comments": [
    { "userKey": "ellis", "catchKey": "creek-bass", "content": "That creek color looks perfect. Craw trailer?" },
    { "userKey": "cole", "catchKey": "creek-bass", "content": "Green pumpkin, 4 inch. They wanted it slow." },
    { "userKey": "marco", "catchKey": "first-carp", "content": "Welcome to carp. Once you catch one you start chasing twenties." },
    { "userKey": "tom", "catchKey": "weekend-pike", "content": "Nice first pike. Wait till you get a 40-incher on that spinnerbait." },
    { "userKey": "cole", "catchKey": "river-smallmouth", "content": "River smallies fight twice their size. Clean fish." },
    { "userKey": "anders", "catchKey": "lake-trout", "content": "That is a tank. What depth were you marking them?" },
    { "userKey": "frank", "catchKey": "lake-trout", "content": "High 80s to 95. Spoon 4 colors back." },
    { "userKey": "finn", "catchKey": "ebro-wels", "content": "Ebro still producing. Respect for getting in the mud with it." },
    { "userKey": "wren", "catchKey": "rainbow-hand", "content": "Hopper season. Love a fish that still has the grass on it." },
    { "userKey": "nate", "catchKey": "brook-trout", "content": "This is the whole sport right here." },
    { "userKey": "jake", "catchKey": "michigan-chinook", "content": "Kings are in! Green spoons have been lights-out for us too." },
    { "userKey": "ellis", "catchKey": "spillway-bass", "content": "Spillway PB hits different. Congrats." },
    { "userKey": "maya", "catchKey": "double-header", "content": "Carp and a bass in one session is a good evening." },
    { "userKey": "luca", "catchKey": "holland-perch", "content": "Proper stripes. IJsselmeer still my favorite perch water." },
    { "userKey": "finn", "catchKey": "madison-fly", "content": "Upper Madison in the rain is church. What size PT?" },
    { "userKey": "wren", "catchKey": "madison-fly", "content": "16 on 5x. They wanted it dead drift under an indicator." },
    { "userKey": "rafael", "catchKey": "parrotfish-stringer", "content": "Looks like dinner is sorted. Nice dive." },
    { "userKey": "frank", "catchKey": "ocean-coho", "content": "Sitka chrome. That fish will smoke beautifully." },
    { "userKey": "wren", "catchKey": "river-atlantic", "content": "Fresh run on the Spey. Fair play for putting it back." }
  ]
